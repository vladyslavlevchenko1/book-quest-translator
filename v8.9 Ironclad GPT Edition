class LoggerProxy
    def __init__(self, app)
        self.app = app

    def info(self, msg)
        try self.app.log_queue.put_nowait(f[INFO] {msg})
        except queue.Full pass

    def warning(self, msg)
        try self.app.log_queue.put_nowait(f[WARN] {msg})
        except queue.Full pass

    def error(self, msg)
        try self.app.log_queue.put_nowait(f[ERROR] {msg})
        except queue.Full pass


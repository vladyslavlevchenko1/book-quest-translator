    def normalize_text(self, s):
        if not isinstance(s, str):
            return ""
        s = s.replace("\r\n", "\n").replace("\r", "\n")
        s = re.sub(r"[ \t]+", " ", s)
        s = re.sub(r"\n+", "\n", s)
        return s.strip()

    def select_folder(self):

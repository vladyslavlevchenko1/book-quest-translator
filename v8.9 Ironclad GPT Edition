    # --- Логика перевода ---

    def make_smart_batches(self, strings)
        deepl_b, google_b, gpt_b = [], [], []
        curr_d, curr_g, curr_gpt = [], [], []
        d_len, g_len, gpt_len = 0, 0, 0

        for s in strings
            s_len = len(s)
            if s_len = 120 # Короткие строки
                if len(curr_d) = 15 or d_len + s_len  self.deepl_max_chars
                    deepl_b.append(curr_d); curr_d, d_len = [], 0
                curr_d.append(s); d_len += s_len
            elif s_len = 800 # Средние
                if len(curr_g) = 10 or g_len + s_len  3000
                    google_b.append(curr_g); curr_g, g_len = [], 0
                curr_g.append(s); g_len += s_len
            else # Длинный лор или текст
                if len(curr_gpt) = 5 or gpt_len + s_len  8000
                    gpt_b.append(curr_gpt); curr_gpt, gpt_len = [], 0
                curr_gpt.append(s); gpt_len += s_len

        if curr_d deepl_b.append(curr_d)
        if curr_g google_b.append(curr_g)
        if curr_gpt gpt_b.append(curr_gpt)
        return deepl_b, google_b, gpt_b

    def request_gpt_batch(self, batch, depth=0, reason=)
        if self.stop_event.is_set() or not self.gpt_client return [None]  len(batch)
        
        # Hash-based cache check
        batch_json = json.dumps(batch, sort_keys=True)
        batch_hash = hashlib.md5(batch_json.encode()).hexdigest()
        if batch_hash in self.gpt_request_history
            self.logger.warning(fGPT batch hash {batch_hash} уже обрабатывался в этой сессии. Пропуск для экономии.)
            return [None]  len(batch)

        if self.gpt_circuit_breaker_until  time.time() return [None]  len(batch)

        mode = self.gpt_mode_combo.get()
        model_name = gpt-4o-mini
        
        # Формируем промпт
        user_content = json.dumps({texts batch}, ensure_ascii=False)
        
        for attempt in range(2)
            try
                time.sleep(self.gpt_delay)
                response = self.gpt_client.chat.completions.create(
                    model=model_name,
                    messages=[{role system, content Translate Minecraft quests to JSON {translations []}},
                              {role user, content user_content}],
                    response_format={type json_object},
                    temperature=0.3
                )
                
                result_text = response.choices[0].message.content
                parsed = self.safe_json_extract_v2(result_text)
                
                if parsed and len(parsed) == len(batch)
                    self.gpt_request_history.add(batch_hash) # Запоминаем успех
                    self.gpt_delay = max(1.0, self.gpt_delay  0.85) # Оптимизировано
                    # Статистика и кост...
                    cost = (response.usage.prompt_tokens  1000000  0.15) + (response.usage.completion_tokens  1000000  0.6)
                    self.update_stats(cost, cost)
                    self.update_stats(gpt, len(batch))
                    return parsed
            
            except Exception as e
                err_text = str(e).lower()
                if any(x in err_text for x in [invalid_api_key, insufficient_quota, model_not_found])
                    self.logger.error(Fatal GPT Error. GPT disabled.)
                    self.gpt_client = None
                    return [None]  len(batch)
                
                self.logger.warning(fGPT API Attempt {attempt+1} failed {e})
                self.gpt_delay = min(15.0, self.gpt_delay  2)
                time.sleep(self.gpt_delay)

        return [None]  len(batch)

    def translate_stage(self, strings)
        if not strings return
        self.logger.info(fСтарт перевода {len(strings)} строк.)
        d_batches, g_batches, gpt_batches = self.make_smart_batches(strings)
        
        total_batches = len(d_batches) + len(g_batches) + len(gpt_batches)
        processed = 0

        # Обработка цепочки (здесь упрощено, вызываем по очереди)
        for b in d_batches
            if self.stop_event.is_set() break
            res = self.request_deepl_batch(b)
            self._apply_translation(b, res)
            processed += 1; self.update_progress_smart(processed, total_batches)

        for b in g_batches
            if self.stop_event.is_set() break
            res = self.google_fallback(b)
            self._apply_translation(b, res)
            processed += 1; self.update_progress_smart(processed, total_batches)

        for b in gpt_batches
            if self.stop_event.is_set() break
            res = self.request_gpt_batch(b)
            self._apply_translation(b, res)
            processed += 1; self.update_progress_smart(processed, total_batches)

    def _apply_translation(self, orig_batch, trans_batch)
        if not trans_batch return
        new_pairs = {}
        for o, t in zip(orig_batch, trans_batch)
            if t and isinstance(t, str) and t.strip()
                # Логика сохранения если оригинал  40 и не изменился - все равно сохраняем
                if len(o)  40 and o.strip() == t.strip()
                    new_pairs[o] = o
                elif o.strip() != t.strip()
                    new_pairs[o] = t
        if new_pairs
            with self.cache_lock self.cache.update(new_pairs)

    def run_pipeline(self)
        self.cleanup_temp_files()
        self.is_running = True
        
        # 1. Поиск файлов
        all_files = []
        for root, _, files in os.walk(self.folder)
            for f in files
                if f.endswith((.json, .snbt))
                    all_files.append(os.path.join(root, f))
        
        # 2. Сканирование
        strings_to_translate = set()
        files_to_process = []
        
        for i, path in enumerate(all_files)
            if self.stop_event.is_set() break
            sig = self.get_signature(path)
            
            with self.state_lock
                if self.file_state.get(path) == sig continue
            
            content, _ = self.read_file_safe(path)
            if not content continue
            
            files_to_process.append(path)
            for m in STRING_PATTERN.finditer(content)
                if self.is_translatable(content, m)
                    val = m.group(1).strip() # Нормализация
                    if not val continue
                    
                    with self.cache_lock
                        if val in self.cache
                            self.update_stats(cache_hits, 1)
                        else
                            strings_to_translate.add(val)
            
            # Лимит буфера
            if len(strings_to_translate) = 3000
                self.translate_stage(list(strings_to_translate))
                strings_to_translate.clear()
            self.update_progress_smart(i+1, len(all_files))

        if strings_to_translate and not self.stop_event.is_set()
            self.translate_stage(list(strings_to_translate))

        # 3. Запись
        if files_to_process and not self.stop_event.is_set()
            self.write_stage(files_to_process)

        self.logger.info(Пайплайн завершен.)
        self.ui_queue.put((reset_controls, None))
        self.is_running = False

    def on_close(self)
        self.stop_event.set()
        if hasattr(self, pipeline_thread) and self.pipeline_thread.is_alive()
            self.logger.info(Ожидание завершения потока...)
            self.pipeline_thread.join(timeout=3.0)
        
        self.atomic_save_json(CACHE_FILE, self.cache, self.cache_lock)
        self.atomic_save_json(STATE_FILE, self.file_state, self.state_lock)
        self.root.destroy()


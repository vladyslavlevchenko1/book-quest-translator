def safe_unescape(text):
    if not isinstance(text, str):
        return ""
    try:
        return json.loads(f'"{text}"')
    except Exception:
        pass
    # Conservative fallback: decode only common safe escapes, preserve the rest.
    s = text
    s = s.replace('\\"', '"')
    s = s.replace('\\n', '\n').replace('\\r', '\r').replace('\\t', '\t')
    s = re.sub(r"\\u([0-9a-fA-F]{4})", lambda m: chr(int(m.group(1), 16)), s)
    s = s.replace('\\\\', '\\')
    return s


class LoggerProxy:
    def __init__(self, app):
        self.app = app
        self._lock = threading.Lock()

    def _rotate_if_needed(self):
        if os.path.exists(LOG_FILE) and os.path.getsize(LOG_FILE) >= MAX_LOG_SIZE:
            for i in range(3, 0, -1):
                src = f"{LOG_FILE}.{i-1}" if i > 1 else LOG_FILE
                dst = f"{LOG_FILE}.{i}"
                if os.path.exists(src):
                    if os.path.exists(dst):
                        os.remove(dst)
                    os.replace(src, dst)

    def _push(self, level, msg):
        line = f"[{level}] {msg}"
        try:
            self.app.log_queue.put_nowait(line)
        except queue.Full:
            pass
        try:
            with self._lock:
                self._rotate_if_needed()
                with open(LOG_FILE, "a", encoding="utf-8", errors="replace") as f:
                    f.write(line + "\n")
        except OSError:
            pass

    def info(self, msg): self._push("INFO", msg)
    def warning(self, msg): self._push("WARN", msg)
    def error(self, msg): self._push("ERROR", msg)



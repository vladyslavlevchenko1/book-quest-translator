CACHE_FILE = "translation_cache.json"
STATE_FILE = "translation_state.json"
LOG_FILE = "translator.log"
TMP_SUFFIX = ".tmp_translate"

STRING_PATTERN = re.compile(r'"([^"\\]*(?:\\.[^"\\]*)*)"')
RESOURCE_ID_PATTERN = re.compile(r"^[a-z0-9_.-]+:[a-z0-9_/.-]+$")
FORMAT_CODE_PATTERN = re.compile(r"(§[0-9a-fk-or])", flags=re.IGNORECASE)
PLACEHOLDER_PATTERN = re.compile(r"(%\d*\$?[sd]|\{\d+\}|\$\{[^}]+\})")


class LoggerProxy:
    def __init__(self, app):
        self.app = app

    def _push(self, level, msg):
        line = f"[{level}] {msg}"
        try:
            self.app.log_queue.put_nowait(line)
        except queue.Full:
            pass
        try:
            with open(LOG_FILE, "a", encoding="utf-8", errors="replace") as f:
                f.write(line + "\n")
        except OSError:
            pass

    def info(self, msg):
        self._push("INFO", msg)

    def warning(self, msg):
        self._push("WARN", msg)

    def error(self, msg):
        self._push("ERROR", msg)


class QuestTranslatorEngine:
    def __init__(self, root):
        self.root = root
        self.root.title("Quest Translator Engine v8.9 Ironclad")
        self.root.geometry("800x650")

        self.log_queue = queue.Queue(maxsize=2000)
        self.ui_queue = queue.Queue(maxsize=5000)

        self.cache_lock = threading.Lock()
        self.state_lock = threading.Lock()
        self.save_lock = threading.Lock()
        self.stat_lock = threading.Lock()

        self.stop_event = threading.Event()
        self.pause_requested = False
        self.is_running = False

        self.cache = {}
        self.file_state = {}
        self.folder = ""
        self.gpt_client = None
        self.gpt_request_history = set()

        self.reset_runtime_state()
        self.setup_network()
        self.logger = LoggerProxy(self)

        self.cache = self.load_json_safe(CACHE_FILE)
        self.file_state = self.load_json_safe(STATE_FILE)
        self.google_translators = {}

        self.build_ui()
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)
        self.root.after(100, self.update_ui_loop)

    def setup_network(self):
        self.session = requests.Session()
        retries = Retry(
            total=3,
            backoff_factor=1,
            status_forcelist=[429, 500, 502, 503, 504],
            allowed_methods={"POST"},
        )
        self.session.mount("https://", HTTPAdapter(max_retries=retries, pool_connections=12, pool_maxsize=12))

    def reset_runtime_state(self):
        self.deepl_disabled_until = 0.0
        self.deepl_max_chars = 1200
        self.current_delay = 0.5
        self.google_delay = 1.0
        self.gpt_delay = 1.5
        self.gpt_consecutive_failures = 0
        self.gpt_circuit_breaker_until = 0.0
        self.last_percent = -1
        self.last_cache_backup_ts = time.time()
        self.backup_interval_sec = 3600
        with self.stat_lock:
            self.stat_data = {"deepl": 0, "google": 0, "gpt": 0, "cache_hits": 0, "failed": 0, "cost": 0.0}


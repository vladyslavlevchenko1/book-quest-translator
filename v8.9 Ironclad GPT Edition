    def load_json_safe(self, path):
        for c in [path, f"{path}.bak"]:
            if not os.path.exists(c): continue
            try:
                with open(c, "r", encoding="utf-8") as f: d = json.load(f)
                if isinstance(d, dict): return d
            except Exception: continue
        return {}

    def _retry_copy2(self, src, dst):
        for i in range(5):
            try: shutil.copy2(src, dst); return True
            except Exception:
                time.sleep(0.05 * (2 ** i))
        return False

    def _retry_replace(self, src, dst):
        for i in range(5):
            try: os.replace(src, dst); return True
            except Exception:
                time.sleep(0.05 * (2 ** i))
        return False

    def atomic_save_json(self, path, data, lock):
        # Atomic save for test-mode crash/power-loss safety.
        with lock:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            fd, tmp = tempfile.mkstemp(prefix=".tmp_", suffix=TMP_SUFFIX, dir=os.path.dirname(path) or ".")
            try:
                with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as f:
                    json.dump(data, f, ensure_ascii=False, separators=(",", ":")); f.flush(); os.fsync(f.fileno())
                if os.path.exists(path): self._retry_copy2(path, f"{path}.bak")  # Backup for rollback safety.
                if not self._retry_replace(tmp, path): raise OSError("replace failed")
            finally:
                if os.path.exists(tmp):
                    try: os.remove(tmp)
                    except OSError: pass

    def cleanup_temp_files(self):
        for p in Path(".").glob(f"*{TMP_SUFFIX}"):
            try: p.unlink(missing_ok=True)
            except OSError: pass

    def compact_cache(self, force=False):
        if self.cache_compacting: return
        with self.cache_lock:
            if not force and len(self.cache) <= MAX_CACHE_SIZE: return
        self.cache_compacting = True
        try:
            removed = 0
            with self.cache_lock:
                nc = {}
                for k, v in self.cache.items():
                    nk = self.normalize_text(k); nv = self.normalize_text(v)
                    if not nk or not nv: removed += 1; continue
                    nc[nk] = nv
                self.cache = nc
                if len(self.cache) > MAX_CACHE_SIZE:
                    keys = list(self.cache.keys())
                    for k in keys[MAX_CACHE_SIZE:]:
                        self.cache.pop(k, None); removed += 1
            self.update_stats("cache_compactions", 1)
            self.logger.info(f"Cache compaction completed, removed={removed}, size={len(self.cache)}")
        finally:
            self.cache_compacting = False

    def maybe_memory_pressure_cleanup(self):
        with self.cache_lock:
            size = len(self.cache)
        if size > MAX_CACHE_SIZE:
            self.logger.warning(f"Memory pressure: cache size {size}, compaction triggered")
            self.compact_cache(force=True)

    def get_signature(self, p):
        st = os.stat(p); return f"{st.st_size}:{int(st.st_mtime)}"
    def read_file_safe(self, p):
        for enc in ("utf-8", "utf-8-sig", "cp1251", "latin-1"):
            try:
                with open(p, "r", encoding=enc, errors="strict", newline="") as f: return f.read(), enc
            except Exception: continue
        return None, None
    def is_translatable(self, v):
        if not v: return False
        s = self.normalize_text(v)
        if not s: return False
        if RESOURCE_ID_PATTERN.match(s): return False
        if re.fullmatch(r"[0-9_./:-]+", s): return False
        return any(c.isalpha() for c in s)

    def has_hallucination_artifacts(self, text):
        low = text.lower()
        if "```" in text or '{"' in text: return True
        for p in ["assistant", "translation", "example", "json:", "here is", "объяснение"]:
            if p in low: return True
        return False

    def validate_translation(self, src, dst):
        if not isinstance(dst, str): return False
        src_n = self.normalize_text(src); dst_n = self.normalize_text(dst)
        if not dst_n: return False
        if self.has_hallucination_artifacts(dst_n): return False
        if len(dst_n) > max(len(src_n) * 6, len(src_n) + 400): return False
        if Counter(PLACEHOLDER_PATTERN.findall(src_n)) != Counter(PLACEHOLDER_PATTERN.findall(dst_n)): return False
        if Counter(FORMAT_CODE_PATTERN.findall(src_n)) != Counter(FORMAT_CODE_PATTERN.findall(dst_n)): return False
        if re.search(r"(.)\1{10,}", dst_n): return False
        words = dst_n.lower().split()
        if words and max(Counter(words).values()) > max(8, len(words) * 0.7): return False
        if re.search(r"[!?.\-_=]{15,}", dst_n): return False
        return True

    def make_smart_batches(self, strings):
        deepl_b=[]; google_b=[]; gpt_b=[]
        cd=[]; cg=[]; cq=[]; dl=gl=ql=0
        for s in strings:
            l=len(s)
            if l<=120:
                if len(cd)>=15 or dl+l>self.deepl_max_chars: deepl_b.append(cd); cd=[]; dl=0
                cd.append(s); dl+=l
            elif l<=800:
                if len(cg)>=10 or gl+l>3000: google_b.append(cg); cg=[]; gl=0
                cg.append(s); gl+=l
            else:
                if len(cq)>=5 or ql+l>7000: gpt_b.append(cq); cq=[]; ql=0
                cq.append(s); ql+=l
        for c,o in ((cd,deepl_b),(cg,google_b),(cq,gpt_b)):
            if c: o.append(c)
        return deepl_b, google_b, gpt_b

    def safe_json_extract_v2(self, t):
        if not t: return []
        try: d=json.loads(t)
        except json.JSONDecodeError:
            self.logger.warning("GPT malformed JSON")
            s=t.find("{"); e=t.rfind("}")
            if s>=0 and e>s:
                try: d=json.loads(t[s:e+1])
                except Exception: return []
            else: return []
        v=d.get("translations") if isinstance(d,dict) else None
        return v if isinstance(v,list) else []

    def estimate_tokens(self, text): return max(1, int(len(text) / 4))
    def estimate_gpt_cost_fallback(self, model, prompt_text, completion_text):
        price = self.pricing.get(model, {"in": 0.15, "out": 0.60})
        pt = self.estimate_tokens(prompt_text); ct = self.estimate_tokens(completion_text)
        self.logger.warning("GPT usage metadata missing; fallback token estimation used")
        return ((pt / 1_000_000) * price["in"]) + ((ct / 1_000_000) * price["out"])

    def request_gpt_batch(self, batch, depth=0):
        if self.stop_event.is_set() or not self.gpt_client: return [None]*len(batch)
        if depth>GPT_MAX_RECURSION_DEPTH:
            self.logger.warning("GPT split depth exceeded")
            return [None]*len(batch)
        h=hashlib.md5(json.dumps(batch,ensure_ascii=False,sort_keys=True).encode()).hexdigest()
        if h in self.gpt_request_history:  # GPT poison batch protection.
            self.logger.warning("GPT batch skipped from history")
            return [None]*len(batch)
        if self.gpt_circuit_breaker_until > time.time():
            self.logger.warning("GPT cooldown active")
            return [None]*len(batch)
        model={"Cheap":"gpt-4o-mini","Balanced":"gpt-4.1-mini","Quality":"gpt-4.1"}.get(self.gpt_mode_combo.get(),"gpt-4o-mini")
        payload=json.dumps({"texts":batch},ensure_ascii=False)
        est=sum(self.estimate_tokens(x) for x in batch)
        if est>3500 and len(batch)>1:
            self.logger.warning(f"GPT split reason=tokens depth={depth} estimate={est}")
            mid=len(batch)//2
            return self.request_gpt_batch(batch[:mid],depth+1)+self.request_gpt_batch(batch[mid:],depth+1)
        for a in range(3):
            if self.stop_event.is_set(): return [None]*len(batch)
            try:
                time.sleep(self.gpt_delay)
                r=self.gpt_client.chat.completions.create(model=model,messages=[{"role":"system","content":"Return JSON object with only translations array same length/order. No markdown."},{"role":"user","content":payload}],response_format={"type":"json_object"},temperature=0.1,timeout=45)
                parsed=self.safe_json_extract_v2(r.choices[0].message.content)
                if len(parsed)!=len(batch): self.logger.warning("GPT invalid batch length"); raise ValueError("bad len")
                out=[]
                for s,t in zip(batch,parsed):
                    if self.validate_translation(s,t): out.append(self.normalize_text(t))
                    else: self.logger.warning("GPT hallucination rejection"); out.append(None)
                if any(out): self.gpt_request_history.add(h)
                u=getattr(r,"usage",None)
                if u and model in self.pricing: c=((u.prompt_tokens/1_000_000)*self.pricing[model]["in"])+((u.completion_tokens/1_000_000)*self.pricing[model]["out"])
                else: c=self.estimate_gpt_cost_fallback(model,payload,r.choices[0].message.content)
                self.update_stats("cost",c); self.update_stats("gpt",sum(1 for x in out if x)); self.gpt_delay=max(1.0,self.gpt_delay*0.85); self.gpt_consecutive_failures=0
                return out
            except Exception as e:
                self.update_stats("gpt_failures",1)
                self.gpt_consecutive_failures+=1; self.gpt_delay=min(20.0,self.gpt_delay*1.8)
                self.logger.warning(f"GPT retry escalation attempt={a+1} err={e}")
                if self.gpt_consecutive_failures>=6:
                    self.gpt_circuit_breaker_until=time.time()+300
                    self.logger.error("GPT circuit breaker activation")
                    self.gpt_request_history.add(h)
                    break
        if len(batch)>1:
            self.logger.warning(f"GPT split recursion depth={depth} reason=failure")
            mid=len(batch)//2
            return self.request_gpt_batch(batch[:mid],depth+1)+self.request_gpt_batch(batch[mid:],depth+1)
        self.logger.error("GPT final failure for batch")
        self.gpt_request_history.add(h)
        return [None]*len(batch)

    def request_deepl_batch(self, batch, depth=0):
        if self.stop_event.is_set() or not batch: return [None]*len(batch)
        if self.deepl_disabled_until>time.time(): return [None]*len(batch)
        key=self.api_entry.get().strip()
        if not key: return [None]*len(batch)
        endpoint = "https://api-free.deepl.com/v2/translate" if key.endswith(":fx") else "https://api.deepl.com/v2/translate"
        self.logger.info(f"DeepL endpoint selected: {'free' if key.endswith(':fx') else 'pro'}")
        if sum(len(s) for s in batch)>6000 and len(batch)>1:
            mid=len(batch)//2
            return self.request_deepl_batch(batch[:mid],depth+1)+self.request_deepl_batch(batch[mid:],depth+1)
        data=[("text",s) for s in batch]; data.extend([("target_lang",self.target_lang.get().strip().upper() or "RU"),("tag_handling","xml")])
        h={"Authorization":f"DeepL-Auth-Key {key}"}
        for a in range(4):
            if self.stop_event.is_set(): return [None]*len(batch)
            try:
                time.sleep(self.current_delay+random.uniform(0,0.2))
                r=self.session.post(endpoint,data=data,headers=h,timeout=35)
                if r.status_code==200:
                    tr=[x.get("text","") for x in r.json().get("translations",[])]
                    if len(tr)!=len(batch): raise ValueError("len mismatch")
                    out=[self.normalize_text(t) if self.validate_translation(s,t) else None for s,t in zip(batch,tr)]
                    self.update_stats("deepl",sum(1 for x in out if x)); self.current_delay=max(0.2,self.current_delay*0.9)
                    return out
                if r.status_code in (429,456):
                    self.update_stats("deepl_rate_limits",1); self.current_delay=min(12.0,self.current_delay*1.8); self.deepl_max_chars=max(400,int(self.deepl_max_chars*0.8)); continue
                if r.status_code==403:
                    self.deepl_disabled_until=time.time()+900; return [None]*len(batch)
            except Exception:
                self.update_stats("deepl_failures",1); self.current_delay=min(12.0,self.current_delay*1.5)
        return [None]*len(batch)

    def google_fallback(self, batch):
        if self.stop_event.is_set() or not batch: return [None]*len(batch)
        lang=self.target_lang.get().strip().lower() or "ru"
        if lang not in self.google_translators: self.google_translators[lang]=GoogleTranslator(source="auto",target=lang)
        tr=self.google_translators[lang]; out=[None]*len(batch)
        for i,t in enumerate(batch):
            for a in range(3):
                if self.stop_event.is_set(): return out
                try:
                    time.sleep(self.google_delay+random.uniform(0,0.25))
                    z=tr.translate(t)
                    if self.validate_translation(t,z): out[i]=self.normalize_text(z); self.update_stats("google",1); break
                except Exception:
                    self.update_stats("google_failures",1); self.google_delay=min(6.0,self.google_delay*1.4)
            if out[i] is None and self.gpt_enable_var.get() and self.gpt_client: out[i]=self.request_gpt_batch([t])[0]
        return out

    def _apply_translation(self, ob, tb):
        if not tb: return
        np={}; failed=0
        for o,t in zip(ob,tb):
            no=self.normalize_text(o)
            if not no: continue
            if t and self.validate_translation(o,t): np[no]=self.normalize_text(t)
            else: failed+=1
        if np:
            with self.cache_lock: self.cache.update(np)
        if failed: self.update_stats("failed",failed)

    def translate_stage(self, strings):
        if not strings: return
        db,gb,qb=self.make_smart_batches(strings)
        total=len(db)+len(gb)+len(qb); p=0
        for b in db:
            if self.stop_event.is_set(): break
            self.total_batches+=1; self.total_batch_strings+=len(b)
            r=self.request_deepl_batch(b); self._apply_translation(b,r)
            miss=[s for s,t in zip(b,r) if not t]
            if miss: self._apply_translation(miss,self.google_fallback(miss))
            p+=1; self.update_progress_smart(p,total)
        for b in gb:
            if self.stop_event.is_set(): break
            self.total_batches+=1; self.total_batch_strings+=len(b)
            r=self.google_fallback(b); self._apply_translation(b,r)
            miss=[s for s,t in zip(b,r) if not t]
            if miss: self._apply_translation(miss,self.request_gpt_batch(miss))
            p+=1; self.update_progress_smart(p,total)
        for b in qb:
            if self.stop_event.is_set(): break
            self.total_batches+=1; self.total_batch_strings+=len(b)
            self._apply_translation(b,self.request_gpt_batch(b)); p+=1; self.update_progress_smart(p,total)

    def _detect_newline_style(self, text):
        if "\r\n" in text: return "\r\n"
        if "\r" in text: return "\r"
        return "\n"

    def write_stage(self, files):
        for path in files:
            if self.stop_event.is_set(): break
            content,enc=self.read_file_safe(path)
            if not content: continue
            nl=self._detect_newline_style(content)
            def repl(m):
                if self._is_json_key(m, content):  # JSON key protection.
                    return m.group(0)
                raw=m.group(1); original=self.normalize_text(safe_unescape(raw))
                with self.cache_lock: tr=self.cache.get(original)
                if not tr: return m.group(0)
                esc=tr.replace("\\","\\\\").replace('"','\\"').replace("\n","\\n")
                return f'"{esc}"'
            new=STRING_PATTERN.sub(repl,content)
            if new==content: continue
            if nl!="\n": new=new.replace("\n",nl)
            fd,tmp=tempfile.mkstemp(prefix=".tmp_file_",suffix=TMP_SUFFIX,dir=os.path.dirname(path) or ".")
            try:
                with os.fdopen(fd,"w",encoding=enc or "utf-8",errors="replace",newline="") as f: f.write(new); f.flush(); os.fsync(f.fileno())
                bak=f"{path}.bak"
                if os.path.exists(path): self._retry_copy2(path,bak)
                if not self._retry_replace(tmp,path): raise OSError("replace failed")
                ok=False
                try:
                    nsz=os.path.getsize(path); osz=max(1,len(content.encode(enc or 'utf-8',errors='ignore')))
                    if nsz>0 and nsz>=osz*0.1: ok=True
                except Exception: ok=False
                if ok:
                    try:
                        with open(path, "r", encoding=enc or "utf-8", errors="strict") as vf:
                            vcontent = vf.read()
                        if not STRING_PATTERN.search(vcontent):
                            ok = False
                    except Exception:
                        ok = False
                if not ok and os.path.exists(bak): self._retry_replace(bak,path)  # Rollback on validation failure.
                with self.state_lock: self.file_state[path]=self.get_signature(path)
            finally:
                if os.path.exists(tmp):
                    try: os.remove(tmp)
                    except OSError: pass

    def autosave_loop(self):
        self.logger.info("Autosave thread started")
        while not self.stop_event.is_set():
            if self.stop_event.wait(AUTOSAVE_INTERVAL): break
            if self.autosave_in_progress: continue
            with self.save_lock:
                self.autosave_in_progress=True
                try:
                    self.compact_cache(force=False)
                    self.atomic_save_json(CACHE_FILE,self.cache,self.cache_lock)
                    self.atomic_save_json(STATE_FILE,self.file_state,self.state_lock)
                    self.export_metrics(); self.update_stats("autosave_count",1)
                finally:
                    self.autosave_in_progress=False
        self.logger.info("Autosave thread exited")

    def export_metrics(self):
        with self.stat_lock: s=dict(self.stat_data)
        runtime=max(1.0,time.time()-self.start_ts) if self.start_ts else 0
        total=max(1,s["total_strings"]); translated=s["deepl"]+s["google"]+s["gpt"]
        m={"total_strings":s["total_strings"],"cache_hits":s["cache_hits"],"deepl_success":s["deepl"],"google_success":s["google"],"gpt_success":s["gpt"],"failed":s["failed"],"estimated_cost":round(s["cost"],6),"runtime_sec":round(runtime,2),"cache_hit_ratio":round(s["cache_hits"]/total,4),"fallback_ratio":round((s["google"]+s["gpt"])/max(1,translated),4),"avg_batch_size":round(self.total_batch_strings/max(1,self.total_batches),2),"deepl_failures":s["deepl_failures"],"google_failures":s["google_failures"],"gpt_failures":s["gpt_failures"],"deepl_rate_limits":s["deepl_rate_limits"],"autosave_count":s["autosave_count"],"skipped_large_files":s["skipped_large_files"],"cache_compactions":s["cache_compactions"],"total_batches":self.total_batches}
        self.atomic_save_json(METRICS_FILE,m,self.save_lock)

    def run_pipeline(self):
        self.cleanup_temp_files(); self.start_ts=time.time(); self.is_running=True; self.logger.info("Pipeline started")
        allf=[]
        for r,_,fs in os.walk(self.folder):
            for f in fs:
                if f.endswith((".json",".snbt")): allf.append(os.path.join(r,f))
        buf=set(); ftp=[]; total=max(1,len(allf))
        for i,p in enumerate(allf,1):
            if self.stop_event.is_set(): break
            while self.pause_requested and not self.stop_event.is_set(): time.sleep(0.2)
            try:
                sz=os.path.getsize(p)
                if sz > LARGE_FILE_WARNING_MB*1024*1024: self.logger.warning(f"Large file warning: {p} size={sz}")
                if sz > LARGE_FILE_SKIP_MB*1024*1024: self.update_stats("skipped_large_files",1); continue
            except Exception: pass
            sig=self.get_signature(p)
            with self.state_lock:
                if self.file_state.get(p)==sig: self.update_progress_smart(i,total); continue
            c,_=self.read_file_safe(p)
            if not c: continue
            ftp.append(p)
            for m in STRING_PATTERN.finditer(c):
                if self.stop_event.is_set(): break
                if self._is_json_key(m, c):
                    continue
                v=self.normalize_text(safe_unescape(m.group(1)))
                if not self.is_translatable(v): continue
                self.update_stats("total_strings",1)
                with self.cache_lock:
                    if v in self.cache: self.update_stats("cache_hits",1); continue
                buf.add(v)
                if len(buf)>=MAX_BATCH_SIZE:
                    self.translate_stage(list(buf)); buf.clear(); self.maybe_memory_pressure_cleanup()
            if i%25==0:
                with self.save_lock:
                    self.compact_cache(force=False); self.atomic_save_json(CACHE_FILE,self.cache,self.cache_lock); self.atomic_save_json(STATE_FILE,self.file_state,self.state_lock); self.export_metrics()
            self.update_progress_smart(i,total)
        if buf and not self.stop_event.is_set(): self.translate_stage(list(buf)); buf.clear()
        if ftp and not self.stop_event.is_set(): self.write_stage(ftp)
        with self.save_lock:
            self.compact_cache(force=False); self.atomic_save_json(CACHE_FILE,self.cache,self.cache_lock); self.atomic_save_json(STATE_FILE,self.file_state,self.state_lock); self.export_metrics()
        self.gpt_request_history.clear()
        self.logger.info("Pipeline finished"); self.is_running=False
        try: self.ui_queue.put_nowait(("reset_controls",None))
        except queue.Full: pass

    def start_translation(self):
        if self.is_running: return
        if not self.folder: self.logger.warning("Select folder first"); return
        self.reset_runtime_state(); self.stop_event.clear(); self.pause_requested=False
        if self.gpt_enable_var.get():
            key=self.gpt_api_entry.get().strip()
            if key: self.gpt_client=OpenAI(api_key=key)
        self.start_btn.config(state=tk.DISABLED); self.pause_btn.config(state=tk.NORMAL); self.stop_btn.config(state=tk.NORMAL)
        self.auto_save_thread=threading.Thread(target=self.autosave_loop,daemon=True); self.auto_save_thread.start()
        self.pipeline_thread=threading.Thread(target=self.run_pipeline,daemon=True); self.pipeline_thread.start()

    def on_close(self):
        self.logger.info("Shutdown initiated")
        self.root_destroyed = True
        self.stop_event.set()
        if self.pipeline_thread and self.pipeline_thread.is_alive(): self.pipeline_thread.join(timeout=10.0)
        if self.auto_save_thread and self.auto_save_thread.is_alive(): self.auto_save_thread.join(timeout=10.0)
        with self.save_lock:
            self.compact_cache(force=False); self.atomic_save_json(CACHE_FILE,self.cache,self.cache_lock); self.atomic_save_json(STATE_FILE,self.file_state,self.state_lock); self.export_metrics()
        self.logger.info("Shutdown complete")
        self.root.destroy()


def main():
    root=tk.Tk(); QuestTranslatorEngine(root); root.mainloop()

if __name__=="__main__":
    main()

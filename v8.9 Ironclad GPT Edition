STATE_FILE = "translation_state.json"
METRICS_FILE = "metrics.json"
LOG_FILE = "translator.log"
TMP_SUFFIX = ".tmp_translate"

STRING_PATTERN = re.compile(r'"([^"\\]*(?:\\.[^"\\]*)*)"')
RESOURCE_ID_PATTERN = re.compile(r"^[a-z0-9_.-]+:[a-z0-9_/.-]+$")
FORMAT_CODE_PATTERN = re.compile(r"(§[0-9a-fk-or])", flags=re.IGNORECASE)
PLACEHOLDER_PATTERN = re.compile(r"(%\d*\$?[sd]|\{\d+\}|\$\{[^}]+\})")


class LoggerProxy:
    def __init__(self, app):
        self.app = app

    def _push(self, level, msg):
        line = f"[{level}] {msg}"
        try:
            self.app.log_queue.put_nowait(line)
        except queue.Full:
            pass
        try:
            with open(LOG_FILE, "a", encoding="utf-8", errors="replace") as f:
                f.write(line + "\n")
        except OSError:
            pass

    def info(self, msg):
        self._push("INFO", msg)

    def warning(self, msg):
        self._push("WARN", msg)

    def error(self, msg):
        self._push("ERROR", msg)



import os
import re
import json
import time
import queue
import shutil
import threading
import requests
from concurrent.futures import ThreadPoolExecutor
from tkinter import Tk, Label, Frame, Button, Text, Entry, END, LEFT, DISABLED, NORMAL, INSERT
from tkinter import filedialog

CACHE_FILE = "translation_cache.json"
STATE_FILE = "translation_state.json"
MESSAGE_QUEUE = queue.Queue()
STRING_PATTERN = re.compile(r'"([^"\\]*(?:\\.[^"\\]*)*)"')


class QuestTranslatorV4:
    def __init__(self, root: Tk):
        self.root = root
        self.root.title("Quest Translator v4.3+")
        self.root.geometry("920x700")

        self.folder = ""
        self.running = False
        self.stop_requested = False

        self.cache_lock = threading.Lock()
        self.deepl_lock = threading.Lock()
        self.last_request_ts = 0.0

        self.cache = self.load_json(CACHE_FILE)
        self.file_state = self.load_json(STATE_FILE)

        self.build_ui()
        self.update_log_loop()
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def build_ui(self):
        Label(self.root, text="Quest Translator v4", font=("Arial", 13, "bold")).pack(pady=10)

        self.label = Label(self.root, text="Папка не выбрана", fg="red")
        self.label.pack()

        panel = Frame(self.root)
        panel.pack(pady=8)
        Button(panel, text="📁 Выбрать папку", command=self.choose_folder).pack(side=LEFT, padx=6)

        Label(self.root, text="DeepL API Key:").pack()
        self.api_entry = Entry(self.root, width=72)
        self.api_entry.pack(pady=5)
        self.api_entry.bind("<Control-v>", self.paste_text)

        controls = Frame(self.root)
        controls.pack(pady=10)
        self.start_btn = Button(controls, text="🚀 Старт", command=self.start_process, width=16, bg="#d4edda")
        self.start_btn.pack(side=LEFT, padx=6)
        self.stop_btn = Button(controls, text="⏹ Стоп", command=self.stop_process, width=16, bg="#f8d7da")
        self.stop_btn.pack(side=LEFT, padx=6)

        self.log_widget = Text(self.root, wrap="word", height=27)
        self.log_widget.pack(expand=True, fill="both", padx=10, pady=10)

    def paste_text(self, _event):
        try:
            self.api_entry.insert(INSERT, self.root.clipboard_get())
        except Exception:
            pass
        return "break"

    def log(self, text: str):
        MESSAGE_QUEUE.put(text)

    def update_log_loop(self):
        while not MESSAGE_QUEUE.empty():
            msg = MESSAGE_QUEUE.get()
            self.log_widget.insert(END, msg + "\n")
            self.log_widget.see(END)
        self.root.after(100, self.update_log_loop)

    @staticmethod
    def load_json(path: str):
        if not os.path.exists(path):
            return {}
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}

    @staticmethod
    def atomic_save_json(path: str, data: dict):
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        os.replace(tmp, path)

    @staticmethod
    def get_signature(path: str):
        st = os.stat(path)
        return f"{st.st_mtime_ns}_{st.st_size}"

    @staticmethod
    def pick_deepl_url(auth_key: str):
        return "https://api-free.deepl.com/v2/translate" if auth_key.endswith(":fx") else "https://api.deepl.com/v2/translate"

    def choose_folder(self):
        picked = filedialog.askdirectory()
        if picked:
            self.folder = picked
            self.label.config(text=f"Папка: {self.folder}", fg="green")

    def collect_files(self):
        files = []
        for root_dir, _, names in os.walk(self.folder):
            for name in names:
                if name.endswith((".json", ".snbt")):
                    files.append(os.path.join(root_dir, name))
        return files

    def is_translatable(self, content: str, match):
        raw = match.group(1)
        tail = content[match.end():match.end() + 1]
        if tail == ":":  # key in "key": value
            return False
        if len(raw.strip()) <= 1:
            return False
        if raw.isdigit():
            return False
        return True

    def pre_scan(self, files):
        self.log(f"[SCAN] Старт: файлов найдено {len(files)}")
        unique = []
        seen = set()
        contents = {}

        for i, path in enumerate(files, 1):
            if self.stop_requested:
                self.log("[SCAN] Остановлено пользователем")
                break
            try:
                sig = self.get_signature(path)
                if self.file_state.get(path) == sig:
                    continue

                with open(path, "r", encoding="utf-8") as f:
                    text = f.read()
                contents[path] = text

                for m in STRING_PATTERN.finditer(text):
                    if not self.is_translatable(text, m):
                        continue
                    value = m.group(1)
                    with self.cache_lock:
                        cached = value in self.cache
                    if not cached and value not in seen:
                        seen.add(value)
                        unique.append(value)

                if i % 100 == 0 or i == len(files):
                    self.log(f"[SCAN] Прогресс: {i}/{len(files)}")
            except Exception as e:
                self.log(f"[SCAN] ⚠️ Ошибка {os.path.basename(path)}: {e}")

        self.log(f"[SCAN] Уникальных строк: {len(unique)}")
        return unique, contents

    def request_deepl_batch(self, batch):
        key = self.api_entry.get().strip()
        if not key:
            raise RuntimeError("DeepL API key пуст")

        url = self.pick_deepl_url(key)
        payload = {"auth_key": key, "target_lang": "RU", "text": batch}
        backoff = [1, 2, 4]

        for attempt in range(3):
            if self.stop_requested:
                return None
            try:
                with self.deepl_lock:
                    delta = time.time() - self.last_request_ts
                    min_delay = 0.35
                    if delta < min_delay:
                        time.sleep(min_delay - delta)

                    response = requests.post(url, data=payload, timeout=30)
                    self.last_request_ts = time.time()

                if response.status_code == 403:
                    self.log(f"[TRANSLATE] ❌ 403 — пропущено {len(batch)} строк")
                    return None

                response.raise_for_status()
                data = response.json()
                translations = data.get("translations", [])
                result = [item.get("text", "") for item in translations]

                if len(result) != len(batch):
                    self.log("[TRANSLATE] ⚠️ mismatch batch size")
                    return None

                return result
            except Exception as e:
                self.log(f"[TRANSLATE] ⚠️ Попытка {attempt + 1}/3: {e}")
                if attempt < 2:
                    time.sleep(backoff[attempt])

        return None

    def translate_stage(self, unique_strings):
        self.log("[TRANSLATE] Старт этапа")
        batches = [unique_strings[i:i + 30] for i in range(0, len(unique_strings), 30)]
        total = len(batches)
        done = 0

        # max_workers = 1 для максимальной стабильности и строгого контроля rate limit
        with ThreadPoolExecutor(max_workers=1) as executor:
            for batch in batches:
                if self.stop_requested:
                    self.log("[TRANSLATE] Остановлено пользователем: новые запросы не отправляются")
                    break

                future = executor.submit(self.request_deepl_batch, batch)
                result = future.result()
                done += 1

                if result is not None:
                    with self.cache_lock:
                        for src, dst in zip(batch, result):
                            self.cache[src] = dst
                        if done % 5 == 0:
                            self.atomic_save_json(CACHE_FILE, self.cache)
                else:
                    self.log(f"[TRANSLATE] ⚠️ Батч {done}/{total} без результата")

                self.log(f"[TRANSLATE] Прогресс батчей: {done}/{total}")

        with self.cache_lock:
            self.atomic_save_json(CACHE_FILE, self.cache)
        self.log("[TRANSLATE] Этап завершен")

    def apply_translations(self, original_text: str):
        def repl(match):
            source = match.group(1)
            tail = original_text[match.end():match.end() + 1]
            if tail == ":":
                return f'"{source}"'
            with self.cache_lock:
                translated = self.cache.get(source, source)
            return '"' + translated.replace('"', '\\"') + '"'

        return STRING_PATTERN.sub(repl, original_text)

    def write_stage(self, files, preloaded):
        self.log("[WRITE] Старт этапа")
        total = len(files)
        for idx, path in enumerate(files, 1):
            try:
                old_text = preloaded.get(path)
                if old_text is None:
                    with open(path, "r", encoding="utf-8") as f:
                        old_text = f.read()

                backup = path + ".bak"
                if not os.path.exists(backup):
                    shutil.copy2(path, backup)

                new_text = self.apply_translations(old_text)
                with open(path, "w", encoding="utf-8") as f:
                    f.write(new_text)

                self.file_state[path] = self.get_signature(path)

                if idx % 100 == 0 or idx == total:
                    self.atomic_save_json(STATE_FILE, self.file_state)
                    self.log(f"[WRITE] Прогресс: {idx}/{total}")
            except Exception as e:
                self.log(f"[WRITE] ⚠️ Ошибка {os.path.basename(path)}: {e}")

        self.atomic_save_json(STATE_FILE, self.file_state)
        self.log("[WRITE] Этап завершен")

    def pipeline(self):
        self.running = True
        self.stop_requested = False
        self.start_btn.config(state=DISABLED)

        try:
            files = self.collect_files()
            if not files:
                self.log("[SCAN] Нет .json/.snbt файлов")
                return

            unique, preloaded = self.pre_scan(files)
            if unique:
                self.translate_stage(unique)

            self.write_stage(files, preloaded)
            self.log("[DONE] Готово")
        except Exception as e:
            self.log(f"[FATAL] {e}")
        finally:
            self.running = False
            self.start_btn.config(state=NORMAL)

    def start_process(self):
        if self.running or not self.folder:
            return
        threading.Thread(target=self.pipeline, daemon=True).start()

    def stop_process(self):
        self.stop_requested = True
        self.log("[CONTROL] Стоп: новые запросы остановлены")

    def on_close(self):
        with self.cache_lock:
            self.atomic_save_json(CACHE_FILE, self.cache)
        self.atomic_save_json(STATE_FILE, self.file_state)
        self.root.destroy()


if __name__ == "__main__":
    root = Tk()
    QuestTranslatorV4(root)
    root.mainloop()

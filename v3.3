import os
import re
import json
import time
import threading
import queue
import requests
from tkinter import *
from tkinter import filedialog, messagebox
from deep_translator import GoogleTranslator

# --- Константы ---
CACHE_FILE = "translation_cache.json"
STATE_FILE = "translation_state.json"
MESSAGE_QUEUE = queue.Queue()

class UniversalQuestTranslator:
    def __init__(self, root):
        self.root = root
        self.root.title("MC Quest Translator v3.3 - Ultimate")
        self.root.geometry("750x650")

        self.cache = self.load_json(CACHE_FILE)
        self.file_state = self.load_json(STATE_FILE)
        self.folder = ""
        self.running = False
        self.translator_choice = StringVar(value="Google")

        self.build_ui()
        self.update_log_loop()
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def build_ui(self):
        Label(self.root, text="Универсальный переводчик (v3.3 - Stable)", font=("Arial", 12, "bold")).pack(pady=10)
        
        self.label = Label(self.root, text="Папка не выбрана", fg="red")
        self.label.pack()

        btn_frame = Frame(self.root)
        btn_frame.pack(pady=5)
        Button(btn_frame, text="📁 Выбрать папку", command=self.choose_folder).pack(side=LEFT, padx=5)
        OptionMenu(btn_frame, self.translator_choice, "Google", "DeepL").pack(side=LEFT, padx=5)

        Label(self.root, text="DeepL API Key:").pack()
        self.api_entry = Entry(self.root, width=50)
        self.api_entry.pack(pady=5)
        self.api_entry.bind("<Control-v>", self.paste_text)

        ctrl_frame = Frame(self.root)
        ctrl_frame.pack(pady=10)
        self.start_btn = Button(ctrl_frame, text="🚀 Начать", command=self.start_process, bg="#d4edda", width=15)
        self.start_btn.pack(side=LEFT, padx=5)
        self.stop_btn = Button(ctrl_frame, text="⏹ Стоп", command=self.stop_process, bg="#f8d7da", width=15)
        self.stop_btn.pack(side=LEFT, padx=5)

        self.log_widget = Text(self.root, wrap="word", height=18)
        self.log_widget.pack(expand=True, fill="both", padx=10, pady=10)

    def paste_text(self, event):
        try:
            self.api_entry.insert(INSERT, self.root.clipboard_get())
        except: pass
        return "break"

    def log(self, msg):
        MESSAGE_QUEUE.put(msg)

    def update_log_loop(self):
        while not MESSAGE_QUEUE.empty():
            msg = MESSAGE_QUEUE.get()
            self.log_widget.insert(END, msg + "\n")
            self.log_widget.see(END)
        self.root.after(100, self.update_log_loop)

    def load_json(self, path):
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    return json.load(f)
            except: return {}
        return {}

    def save_json(self, path, data):
        """Атомарное сохранение с защитой от блокировок Windows"""
        tmp = path + ".tmp"
        for _ in range(5):
            try:
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
                if os.path.exists(path):
                    os.remove(path)
                os.rename(tmp, path)
                return
            except PermissionError:
                time.sleep(0.5)
            except Exception as e:
                self.log(f"⚠️ Ошибка записи {path}: {e}")
                break

    def choose_folder(self):
        path = filedialog.askdirectory()
        if path:
            self.folder = path
            self.label.config(text=f"Папка: {self.folder}", fg="green")

    def translate_batch(self, batch):
        """Улучшенная логика запросов к API"""
        for attempt in range(3):
            if not self.running: return None
            try:
                if self.translator_choice.get() == "Google":
                    return GoogleTranslator(source='en', target='ru').translate_batch(batch)
                else:
                    key = self.api_entry.get().strip()
                    # Точное определение эндпоинта
                    url = "https://api-free.deepl.com/v2/translate" if key.endswith(":fx") else "https://api.deepl.com/v2/translate"
                    
                    # Стабильный формат данных для DeepL[cite: 2]
                    payload = {
                        "auth_key": key,
                        "target_lang": "RU",
                        "text": batch
                    }
                    r = requests.post(url, data=payload, timeout=15)
                    
                    if r.status_code == 403:
                        self.log("❌ 403 Forbidden: Проверь ключ или VPN (нужна Европа)!")
                        return None
                    
                    r.raise_for_status()
                    return [x["text"] for x in r.json()["translations"]]
            except Exception as e:
                self.log(f"⚠️ Попытка {attempt+1}: {e}")
                time.sleep(1)
        return None

    def worker(self):
        self.running = True
        self.start_btn.config(state=DISABLED)
        
        files = []
        for r, _, f in os.walk(self.folder):
            for file in f:
                if file.endswith((".snbt", ".json")):
                    files.append(os.path.join(r, file))

        self.log(f"🔎 Найдено файлов: {len(files)}")

        for i, path in enumerate(files):
            if not self.running: break
            
            f_stat = os.stat(path)
            sig = f"{f_stat.st_mtime_ns}_{f_stat.st_size}"
            if self.file_state.get(path) == sig:
                continue

            try:
                with open(path, "r", encoding="utf-8") as f:
                    content = f.read()

                if not os.path.exists(path + ".bak"):
                    with open(path + ".bak", "w", encoding="utf-8") as f: f.write(content)

                # Сохраняем порядок уникальных строк
                matches = re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"', content)
                todo = []
                seen = set()
                for m in matches:
                    if len(m.strip()) > 1 and not m.isdigit() and ":" not in m:
                        if m not in self.cache and m not in seen:
                            todo.append(m)
                            seen.add(m)

                if todo:
                    for j in range(0, len(todo), 20):
                        if not self.running: break
                        batch = todo[j:j+20]
                        res = self.translate_batch(batch)
                        if res:
                            for o, t in zip(batch, res): self.cache[o] = t
                        else:
                            # Если API упал, прекращаем файл, чтобы не портить кэш
                            raise RuntimeError("API недоступен")
                        time.sleep(0.4)

                def repl(m):
                    orig = m.group(1)
                    if content[m.end():m.end()+1] == ":": return f'"{orig}"'
                    trans = self.cache.get(orig, orig)
                    return f'"{trans.replace('"', '\\"')}"'

                new_content = re.sub(r'"([^"\\]*(?:\\.[^"\\]*)*)"', repl, content)
                
                with open(path, "w", encoding="utf-8") as f:
                    f.write(new_content)
                
                self.file_state[path] = sig
                if (i + 1) % 10 == 0:
                    self.save_json(CACHE_FILE, self.cache)
                    self.save_json(STATE_FILE, self.file_state)
                    self.log(f"✅ Готово: {i+1}/{len(files)}")

            except Exception as e:
                self.log(f"❌ Проблема в {os.path.basename(path)}: {e}")

        self.save_json(CACHE_FILE, self.cache)
        self.save_json(STATE_FILE, self.file_state)
        self.log("🏁 ПРОЦЕСС ЗАВЕРШЕН")
        self.running = False
        self.start_btn.config(state=NORMAL)

    def start_process(self):
        if not self.folder: return
        threading.Thread(target=self.worker, daemon=True).start()

    def stop_process(self):
        self.running = False

    def on_close(self):
        self.save_json(CACHE_FILE, self.cache)
        self.save_json(STATE_FILE, self.file_state)
        self.root.destroy()

if __name__ == "__main__":
    root = Tk()
    UniversalQuestTranslator(root)
    root.mainloop()
